{
  "openapi": "3.0.0",
  "info": {
    "title": "Favorite Movies API",
    "version": "1.0.0",
    "description": "CRUD API for managing movie and review records in MongoDB Atlas."
  },
  "servers": [
    {
      "url": "http://localhost:3000",
      "description": "Local development server"
    },
    {
      "url": "https://week3-week4-project.onrender.com",
      "description": "Render deployment URL"
    }
  ],
  "security": [
    { "sessionCookie": [] }
  ],
  "tags": [
    {
      "name": "Movies",
      "description": "Operations for favorite movie records"
    },
    {
      "name": "Authentication",
      "description": "Local account and Google sign-in operations"
    },
    {
      "name": "Movies",
      "description": "Operations for favorite movie records"
    },
    {
      "name": "Reviews",
      "description": "Operations for movie reviews"
    },
    {
      "name": "Health",
      "description": "Application health check"
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "security": [],
        "tags": ["Health"],
        "summary": "Check if the API server is running",
        "responses": {
          "200": {
            "description": "Server is healthy",
            "content": {
              "application/json": {
                "example": {
                  "status": "ok"
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/register": {
      "post": {
        "security": [],
        "tags": ["Authentication"],
        "summary": "Create a local account and sign in",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/Credentials" },
              "example": { "email": "alex@example.com", "password": "SecurePassword123!" }
            }
          }
        },
        "responses": {
          "201": { "description": "Account created; session cookie set" },
          "400": { "description": "Invalid email or password length" },
          "409": { "description": "Email is already registered" },
          "429": { "description": "Too many authentication attempts" }
        }
      }
    },
    "/api/auth/login": {
      "post": {
        "security": [],
        "tags": ["Authentication"],
        "summary": "Sign in with an email and password",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/Credentials" },
              "example": { "email": "alex@example.com", "password": "SecurePassword123!" }
            }
          }
        },
        "responses": {
          "200": { "description": "Signed in; session cookie set" },
          "400": { "description": "Email and password are required" },
          "401": { "description": "Invalid email or password" },
          "429": { "description": "Too many authentication attempts" }
        }
      }
    },
    "/api/auth/me": {
      "get": {
        "tags": ["Authentication"],
        "summary": "Get the signed-in user's profile",
        "responses": {
          "200": { "description": "Current user profile" },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/api/auth/logout": {
      "post": {
        "tags": ["Authentication"],
        "summary": "Sign out and invalidate the current session",
        "responses": {
          "200": { "description": "Session invalidated and cookie cleared" },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/api/auth/google": {
      "get": {
        "security": [],
        "tags": ["Authentication"],
        "summary": "Begin Google OAuth sign-in",
        "responses": {
          "302": { "description": "Redirect to Google consent" },
          "503": { "description": "Google OAuth credentials are not configured" }
        }
      }
    },
    "/api/auth/google/callback": {
      "get": {
        "security": [],
        "tags": ["Authentication"],
        "summary": "Complete Google OAuth sign-in",
        "responses": {
          "200": { "description": "Signed in; session cookie set" },
          "401": { "description": "Google account did not provide a verified email" },
          "503": { "description": "Google OAuth credentials are not configured" },
          "500": { "description": "OAuth callback could not be completed" }
        }
      }
    },
    "/api/movies": {
      "get": {
        "tags": ["Movies"],
        "summary": "Get all movies",
        "responses": {
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "200": {
            "description": "Successful response with list of movies",
            "content": {
              "application/json": {
                "example": [
                  {
                    "_id": "64be8ac8f1d6d867f1a6a2b1",
                    "title": "Inception",
                    "year": 2010,
                    "genre": "Sci-Fi",
                    "director": "Christopher Nolan",
                    "rating": 8.8,
                    "favorite": true,
                    "createdAt": "2026-09-25T00:00:00.000Z",
                    "updatedAt": "2026-09-25T00:00:00.000Z"
                  }
                ]
              }
            }
          }
        }
      },
      "post": {
        "tags": ["Movies"],
        "summary": "Create a new movie",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MovieInput"
              },
              "example": {
                "title": "Inception",
                "year": 2010,
                "genre": "Sci-Fi",
                "director": "Christopher Nolan",
                "rating": 8.8,
                "favorite": true
              }
            }
          }
        },
        "responses": {
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "201": {
            "description": "Movie created successfully",
            "content": {
              "application/json": {
                "example": {
                  "_id": "64be8ac8f1d6d867f1a6a2b1",
                  "title": "Inception",
                  "year": 2010,
                  "genre": "Sci-Fi",
                  "director": "Christopher Nolan",
                  "rating": 8.8,
                  "favorite": true,
                  "createdAt": "2026-09-25T00:00:00.000Z",
                  "updatedAt": "2026-09-25T00:00:00.000Z"
                }
              }
            }
          },
          "400": {
            "description": "Validation failed"
          },
          "500": {
            "description": "Server error"
          }
        }
      }
    },
    "/api/movies/{id}": {
      "get": {
        "tags": ["Movies"],
        "summary": "Get a movie by ID",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "MongoDB movie ID",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "200": {
            "description": "Movie found",
            "content": {
              "application/json": {
                "example": {
                  "_id": "64be8ac8f1d6d867f1a6a2b1",
                  "title": "Inception",
                  "year": 2010,
                  "genre": "Sci-Fi",
                  "director": "Christopher Nolan",
                  "rating": 8.8,
                  "favorite": true
                }
              }
            }
          },
          "400": {
            "description": "Invalid movie ID"
          },
          "404": {
            "description": "Movie not found"
          }
        }
      },
      "put": {
        "tags": ["Movies"],
        "summary": "Update a movie by ID",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "MongoDB movie ID",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MovieUpdate"
              },
              "example": {
                "rating": 9.1,
                "favorite": true
              }
            }
          }
        },
        "responses": {
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "200": {
            "description": "Movie updated successfully",
            "content": {
              "application/json": {
                "example": {
                  "_id": "64be8ac8f1d6d867f1a6a2b1",
                  "title": "Inception",
                  "year": 2010,
                  "genre": "Sci-Fi",
                  "director": "Christopher Nolan",
                  "rating": 9.1,
                  "favorite": true
                }
              }
            }
          },
          "400": {
            "description": "Invalid movie ID or validation failed"
          },
          "404": {
            "description": "Movie not found"
          }
        }
      },
      "delete": {
        "tags": ["Movies"],
        "summary": "Delete a movie by ID",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "MongoDB movie ID",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "200": {
            "description": "Movie deleted successfully",
            "content": {
              "application/json": {
                "example": {
                  "message": "Movie deleted successfully",
                  "movie": {
                    "_id": "64be8ac8f1d6d867f1a6a2b1",
                    "title": "Inception",
                    "year": 2010,
                    "genre": "Sci-Fi",
                    "director": "Christopher Nolan",
                    "rating": 8.8,
                    "favorite": true
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid movie ID"
          },
          "404": {
            "description": "Movie not found"
          }
        }
      }
    },
    "/api/movies/{movieId}/reviews": {
      "parameters": [
        {
          "name": "movieId",
          "in": "path",
          "required": true,
          "description": "MongoDB movie ID",
          "schema": { "type": "string" }
        }
      ],
      "get": {
        "tags": ["Reviews"],
        "summary": "Get reviews for a movie",
        "responses": {
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "200": { "description": "Movie reviews returned successfully" },
          "400": { "description": "Invalid movie ID" },
          "404": { "description": "Movie not found" },
          "500": { "description": "Server error" }
        }
      },
      "post": {
        "tags": ["Reviews"],
        "summary": "Create a review for a movie",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/ReviewFields" },
              "example": {
                "reviewer": "Alex Example",
                "rating": 9,
                "comment": "Inventive and tightly paced."
              }
            }
          }
        },
        "responses": {
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "201": { "description": "Review created successfully" },
          "400": { "description": "Validation failed or invalid movie ID" },
          "404": { "description": "Movie not found" },
          "500": { "description": "Server error" }
        }
      }
    },
    "/api/movies/{movieId}/reviews/{id}": {
      "parameters": [
        {
          "name": "movieId",
          "in": "path",
          "required": true,
          "description": "MongoDB movie ID",
          "schema": { "type": "string" }
        },
        {
          "name": "id",
          "in": "path",
          "required": true,
          "description": "MongoDB review ID",
          "schema": { "type": "string" }
        }
      ],
      "get": {
        "tags": ["Reviews"],
        "summary": "Get a movie review by movie and review IDs",
        "responses": {
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "200": { "description": "Review found" },
          "400": { "description": "Invalid movie or review ID" },
          "404": { "description": "Movie or review not found" },
          "500": { "description": "Server error" }
        }
      },
      "put": {
        "tags": ["Reviews"],
        "summary": "Update a movie review by movie and review IDs",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/ReviewFieldsUpdate" },
              "example": { "rating": 9.5 }
            }
          }
        },
        "responses": {
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "200": { "description": "Review updated successfully" },
          "400": { "description": "Invalid ID, empty body, or validation failed" },
          "404": { "description": "Movie or review not found" },
          "500": { "description": "Server error" }
        }
      },
      "delete": {
        "tags": ["Reviews"],
        "summary": "Delete a movie review by movie and review IDs",
        "responses": {
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "200": { "description": "Review deleted successfully" },
          "400": { "description": "Invalid movie or review ID" },
          "404": { "description": "Movie or review not found" },
          "500": { "description": "Server error" }
        }
      }
    },
    "/api/reviews": {
      "get": {
        "tags": ["Reviews"],
        "summary": "Get all reviews",
        "responses": {
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "200": {
            "description": "Reviews returned successfully"
          },
          "500": {
            "description": "Server error"
          }
        }
      },
      "post": {
        "tags": ["Reviews"],
        "summary": "Create a review",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ReviewInput"
              },
              "example": {
                "movieId": "64be8ac8f1d6d867f1a6a2b1",
                "reviewer": "Alex Example",
                "rating": 9,
                "comment": "Inventive and tightly paced."
              }
            }
          }
        },
        "responses": {
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "201": {
            "description": "Review created successfully"
          },
          "400": {
            "description": "Validation failed"
          },
          "500": {
            "description": "Server error"
          }
        }
      }
    },
    "/api/reviews/{id}": {
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "description": "MongoDB review ID",
          "schema": {
            "type": "string"
          }
        }
      ],
      "get": {
        "tags": ["Reviews"],
        "summary": "Get a review by ID",
        "responses": {
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "200": {
            "description": "Review found"
          },
          "400": {
            "description": "Invalid review ID"
          },
          "404": {
            "description": "Review not found"
          },
          "500": {
            "description": "Server error"
          }
        }
      },
      "put": {
        "tags": ["Reviews"],
        "summary": "Update a review by ID",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ReviewUpdate"
              },
              "example": {
                "rating": 9.5
              }
            }
          }
        },
        "responses": {
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "200": {
            "description": "Review updated successfully"
          },
          "400": {
            "description": "Invalid review ID, empty body, or validation failed"
          },
          "404": {
            "description": "Review not found"
          },
          "500": {
            "description": "Server error"
          }
        }
      },
      "delete": {
        "tags": ["Reviews"],
        "summary": "Delete a review by ID",
        "responses": {
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "200": {
            "description": "Review deleted successfully"
          },
          "400": {
            "description": "Invalid review ID"
          },
          "404": {
            "description": "Review not found"
          },
          "500": {
            "description": "Server error"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "sessionCookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "movie.sid",
        "description": "HTTP-only session cookie issued by registration, login, or Google OAuth."
      }
    },
    "responses": {
      "Unauthorized": {
        "description": "Authentication is required; sign in and send the session cookie."
      }
    },
    "schemas": {
      "Credentials": {
        "type": "object",
        "required": ["email", "password"],
        "properties": {
          "email": { "type": "string", "format": "email" },
          "password": {
            "type": "string",
            "minLength": 12,
            "maxLength": 72,
            "description": "12 to 72 UTF-8 bytes; stored as a bcrypt hash."
          }
        }
      },
      "MovieInput": {
        "type": "object",
        "required": [
          "title",
          "year",
          "genre",
          "director",
          "rating"
        ],
        "properties": {
          "title": {
            "type": "string",
            "description": "Movie title",
            "example": "Inception"
          },
          "year": {
            "type": "integer",
            "description": "Release year",
            "minimum": 1888,
            "maximum": 2100,
            "example": 2010
          },
          "genre": {
            "type": "string",
            "description": "Movie genre",
            "example": "Sci-Fi"
          },
          "director": {
            "type": "string",
            "description": "Movie director",
            "example": "Christopher Nolan"
          },
          "rating": {
            "type": "number",
            "description": "Movie rating between 0 and 10",
            "minimum": 0,
            "maximum": 10,
            "example": 8.8
          },
          "favorite": {
            "type": "boolean",
            "description": "Whether the movie is marked as favorite",
            "example": true
          }
        }
      },
      "MovieUpdate": {
        "type": "object",
        "minProperties": 1,
        "properties": {
          "title": {
            "type": "string",
            "example": "Interstellar"
          },
          "year": {
            "type": "integer",
            "minimum": 1888,
            "maximum": 2100,
            "example": 2014
          },
          "genre": {
            "type": "string",
            "example": "Sci-Fi"
          },
          "director": {
            "type": "string",
            "example": "Christopher Nolan"
          },
          "rating": {
            "type": "number",
            "minimum": 0,
            "maximum": 10,
            "example": 9.1
          },
          "favorite": {
            "type": "boolean",
            "example": true
          }
        }
      },
      "ReviewInput": {
        "type": "object",
        "required": ["movieId"],
        "allOf": [
          { "$ref": "#/components/schemas/ReviewFields" }
        ],
        "properties": {
          "movieId": {
            "type": "string",
            "description": "ID of an existing movie",
            "example": "64be8ac8f1d6d867f1a6a2b1"
          }
        }
      },
      "ReviewFields": {
        "type": "object",
        "required": ["reviewer", "rating", "comment"],
        "properties": {
          "reviewer": {
            "type": "string",
            "minLength": 1,
            "example": "Alex Example"
          },
          "rating": {
            "type": "number",
            "minimum": 0,
            "maximum": 10,
            "example": 9
          },
          "comment": {
            "type": "string",
            "minLength": 1,
            "example": "Inventive and tightly paced."
          }
        }
      },
      "ReviewFieldsUpdate": {
        "type": "object",
        "minProperties": 1,
        "properties": {
          "reviewer": {
            "type": "string",
            "minLength": 1,
            "example": "Alex Example"
          },
          "rating": {
            "type": "number",
            "minimum": 0,
            "maximum": 10,
            "example": 9.5
          },
          "comment": {
            "type": "string",
            "minLength": 1,
            "example": "Inventive and tightly paced."
          }
        }
      },
      "ReviewUpdate": {
        "type": "object",
        "minProperties": 1,
        "properties": {
          "movieId": {
            "type": "string",
            "description": "ID of an existing movie to relink the review",
            "example": "64be8ac8f1d6d867f1a6a2b1"
          },
          "reviewer": {
            "type": "string",
            "minLength": 1,
            "example": "Alex Example"
          },
          "rating": {
            "type": "number",
            "minimum": 0,
            "maximum": 10,
            "example": 9.5
          },
          "comment": {
            "type": "string",
            "minLength": 1,
            "example": "Inventive, memorable, and tightly paced."
          }
        }
      }
    }
  }
}
